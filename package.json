{
  "name": "pioneer-sheets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "test:dev": "node --test tests/pioneer-dev.test.mjs",
    "build": "bun run prepare:agent && vite build",
    "start": "node packaging/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 30000 tests/sdk.test.ts tests/agent-*.test.ts tests/files.test.ts tests/exchange.test.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:restart": "playwright test --project=chromium -g \"service restart\"",
    "prepare:agent": "bun scripts/build-agent.ts && bun scripts/build-agent-reference.ts",
    "test:agent": "bun test tests/agent-*.test.ts",
    "test:exchange": "bun test --timeout 30000 tests/files.test.ts tests/exchange.test.ts",
    "build:pioneer": "bun run build",
    "package:pioneer": "node scripts/pioneer/package.mjs",
    "verify:pioneer": "python3 scripts/pioneer/verify.py",
    "test:webkit": "playwright test --project=webkit",
    "predev": "bun run prepare:agent",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
